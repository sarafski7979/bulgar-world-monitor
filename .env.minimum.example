# =============================================================================
# BULGAR — WORLD MONITOR  ·  FREE WORLD MAP MONITORING
# Minimum production environment template for a Vercel deployment
# =============================================================================
#
# `.env.example` remains the complete, authoritative reference — it documents
# 271 variables. This file is a curated subset: the variables that most change
# what a Bulgar deployment can actually show. Every name here appears in
# `.env.example` and is read by code in this repository; nothing is invented.
#
# HOW TO READ EACH ENTRY
#   REQUIRED / OPTIONAL   whether the deployment works without it
#   SERVER-SIDE           read only by Vercel functions, the relay, or seeds.
#                         Never exposed to the browser.
#   CLIENT-SAFE           `VITE_`-prefixed, inlined into the JS bundle at build
#                         time and therefore PUBLIC. Never put a secret here.
#   ENABLES               what appears (or stops degrading) when it is set
#   WITHOUT IT            the upstream fallback, verbatim from the graceful-
#                         degradation registry in src/services/runtime-config.ts
#
# WHERE TO PUT THESE
#   Vercel → Project → Settings → Environment Variables.
#   Server-side values: Production + Preview. Do NOT tick "Development" unless
#   you are also running locally.
#   `VITE_` values are build-time — changing one requires a redeploy, not just
#   a restart.
#
# THE HEADLINE: NONE OF THIS IS REQUIRED TO GET A WORKING MAP.
#   With zero variables set, the app builds and serves, the map renders, and
#   every public-source layer works: earthquakes, wildfires (public VIIRS),
#   weather, news/RSS, infrastructure, shipping chokepoints, minerals, country
#   risk, satellites, and market data from free sources. Keys and the relay add
#   the live/authenticated layers on top.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. DEPLOYMENT IDENTITY
# -----------------------------------------------------------------------------

# OPTIONAL · SERVER-SIDE
# Public base URL used when building shareable brief links
# (api/brief/share-url.ts). Set to your Vercel production domain.
# ENABLES: correct absolute links in shared briefs.
# WITHOUT IT: share links fall back to the upstream default origin.
# Example: https://bulgar-world-monitor.vercel.app
WORLDMONITOR_PUBLIC_BASE_URL=

# OPTIONAL · SERVER-SIDE
# Site URL used to build payment checkout return links
# (convex/payments/checkout.ts). Only relevant if you enable the paid tier.
# WITHOUT IT: checkout return URLs use the upstream default.
SITE_URL=

# OPTIONAL · CLIENT-SAFE (build-time)
# Which site variant this deployment builds: full | tech | finance | commodity
# | happy | energy. Bulgar — World Monitor is the `full` variant.
# WITHOUT IT: `full` is the default, which is what you want.
VITE_VARIANT=


# -----------------------------------------------------------------------------
# 2. CROSS-USER CACHE  —  the single highest-value variable pair
# -----------------------------------------------------------------------------
# Upstash Redis over REST. Referenced by ~99 files across api/ and server/.
# Deduplicates AI calls and caches risk scores, seeds and layer payloads across
# visitors, so one cold fetch serves everyone instead of every visitor paying
# for it. Create a free database at https://upstash.com/
#
# Without Redis the app still works, but every request that would have been a
# cache hit becomes a live upstream fetch — which is what makes a free-tier
# deployment hit third-party rate limits first.

# OPTIONAL (strongly recommended) · SERVER-SIDE
UPSTASH_REDIS_REST_URL=

# OPTIONAL (strongly recommended) · SERVER-SIDE
UPSTASH_REDIS_REST_TOKEN=


# -----------------------------------------------------------------------------
# 3. REALTIME RELAY  —  see docs/RAILWAY_RELAY_SETUP.md
# -----------------------------------------------------------------------------
# Vercel functions cannot hold a long-lived WebSocket. Upstream therefore runs
# AIS vessel ingestion, OpenSky aircraft polling, the RSS proxy and the optional
# Telegram poller in a separate always-on process (scripts/ais-relay.cjs),
# designed for Railway. These variables connect Vercel to that process.
#
# Set these THREE together or none of them. WS_RELAY_URL alone does not work:
# the relay refuses to start without RELAY_SHARED_SECRET.

# OPTIONAL · SERVER-SIDE
# https:// URL of the relay, used by Vercel functions to reach it
# (api/_relay.js, api/telegram-feed.js, api/x-feed.js).
# ENABLES: AIS vessel tracking, AviationStack international flight delays.
# WITHOUT IT: relay-backed endpoints answer 503; the AIS layer is disabled and
#             non-US airports use simulated delay data.
WS_RELAY_URL=

# REQUIRED IF the relay is deployed · SERVER-SIDE — TRUE SECRET
# Shared secret authenticating requests to the relay. The relay REFUSES TO
# START without it. Generate with: openssl rand -hex 32
# Set the SAME value on Railway and on Vercel.
RELAY_SHARED_SECRET=

# OPTIONAL · SERVER-SIDE
# Header name carrying the relay secret. Must match on both platforms.
# Default: x-relay-key
RELAY_AUTH_HEADER=x-relay-key

# OPTIONAL · SERVER-SIDE (set on the RELAY host, not on Vercel)
# AISStream key for live vessel positions. Get one at https://aisstream.io/
# ENABLES: live maritime / AIS vessel layer.
# WITHOUT IT: "AIS layer is disabled."
AISSTREAM_API_KEY=

# OPTIONAL · SERVER-SIDE (set on the RELAY host, not on Vercel)
# OpenSky Network OAuth2 credentials — higher rate limits for cloud IPs.
# Register at https://opensky-network.org/
# ENABLES: denser military/aircraft flight coverage.
# WITHOUT IT: "Military flights fall back to limited/no data." Note that the
#             current military-flight path (Redis-backed edge handler) needs no
#             credentials at all; these improve the legacy direct-proxy path.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# 4. DATA-LAYER KEYS  —  each one unlocks exactly one layer
# -----------------------------------------------------------------------------
# All optional. All server-side. Every fallback below is quoted from
# src/services/runtime-config.ts, which is the code that actually decides
# whether a feature renders or shows its disabled state.

# OPTIONAL · SERVER-SIDE — Cloudflare Radar (free Cloudflare account + Radar)
# ENABLES: internet outage layer.
# WITHOUT IT: "Outage layer is disabled and map continues with other feeds."
CLOUDFLARE_API_TOKEN=

# OPTIONAL · SERVER-SIDE — ACLED conflict & protest events
# Register at https://acleddata.com/ → My Account → API Access
# ENABLES: conflict and protest overlays.
# WITHOUT IT: "Conflict/protest overlays are hidden."
# NOTE: this static token expires after 24h. `.env.example` documents an
#       ACLED_EMAIL / ACLED_PASSWORD pair that auto-refreshes — prefer that for
#       an unattended deployment.
ACLED_ACCESS_TOKEN=

# OPTIONAL · SERVER-SIDE — UCDP (Uppsala Conflict Data Program)
# Register at https://ucdp.uu.se/apidocs/
# ENABLES: UCDP conflict event layer.
# WITHOUT IT: "UCDP conflict layer is disabled."
UCDP_ACCESS_TOKEN=

# OPTIONAL · SERVER-SIDE — NASA FIRMS satellite fire detection
# Register at https://firms.modaps.eosdis.nasa.gov/
# ENABLES: enriched FIRMS fire layer.
# WITHOUT IT: "FIRMS fire layer uses public VIIRS feed." The wildfire layer
#             still works — this only upgrades the source.
NASA_FIRMS_API_KEY=

# OPTIONAL · SERVER-SIDE — FRED (US Federal Reserve economic data)
# Free key at https://fred.stlouisfed.org/docs/api/api_key.html
# ENABLES: FRED economic indicators AND the shipping-rates half of Supply Chain
#          Intelligence (Baltic Dry Index).
# WITHOUT IT: "Economic panel remains available with non-FRED metrics." and
#             "Chokepoints and minerals always available; shipping requires
#             FRED key."
FRED_API_KEY=

# OPTIONAL · SERVER-SIDE — EIA (US Energy Information Administration)
# Free key at https://www.eia.gov/opendata/
# ENABLES: oil analytics cards.
# WITHOUT IT: "Oil analytics cards show disabled state."
EIA_API_KEY=

# OPTIONAL · SERVER-SIDE — Finnhub market data
# Free tier at https://finnhub.io/
# ENABLES: delayed/seeded stock quotes. A key is NOT a live tape.
# WITHOUT IT: "Stock ticker uses limited free data."
FINNHUB_API_KEY=

# OPTIONAL · SERVER-SIDE — Wingbits aircraft enrichment (owner, operator, type)
# Contact https://wingbits.com/
# ENABLES: operator/aircraft metadata on military flights.
# WITHOUT IT: "Flight map still renders with heuristic-only classification."
WINGBITS_API_KEY=


# -----------------------------------------------------------------------------
# 5. CLIENT-SAFE BUILD FLAGS
# -----------------------------------------------------------------------------
# `VITE_`-prefixed values are compiled into the public JS bundle. They are
# readable by anyone who opens devtools. `npm run security:vite-env-secrets`
# runs as the first step of the production build and FAILS the build if a
# VITE_ name looks like a secret (matches api_key / token / secret / password /
# credential). Do not work around it — move the value server-side instead.

# OPTIONAL · CLIENT-SAFE
# Self-hosted PMTiles basemap URL (Cloudflare R2 or any HTTP server).
# WITHOUT IT: free OpenFreeMap tiles are used, which is a working default.
# See https://protomaps.com/docs/pmtiles
VITE_PMTILES_URL=

# OPTIONAL · CLIENT-SAFE
# Maritime AIS layer toggle. Default ON; set "false" to hide it.
# Worth setting to "false" if you are NOT running a relay, so the layer does
# not appear in the catalog with nothing behind it.
VITE_ENABLE_AIS=

# OPTIONAL · CLIENT-SAFE
# Sentry DSN for browser error reporting. A DSN is a public ingest endpoint,
# not a secret — this is the one `VITE_` value that is meant to be visible.
# WITHOUT IT: no browser error reporting.
VITE_SENTRY_DSN=


# =============================================================================
# WHAT IS DELIBERATELY NOT HERE
# =============================================================================
# `.env.example` also covers Clerk auth, Convex, Dodo payments, R2/KV
# bootstrap, Resend email, VAPID web push, Telegram MTProto, LLM providers
# (Groq / OpenRouter / Ollama / Anthropic), and the seed-script credentials.
# None of them are needed for a read-only public world-map deployment, and each
# pulls in a third-party account. Read `.env.example` and add them deliberately.
#
# NEVER commit a filled-in copy of this file. `.gitignore` already excludes
# `.env` and `.env.local`; this `.example` file is committed empty by design.
# =============================================================================
